{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "defaultKind", "i18n", "profiles", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "defaultKind": { "enum": ["public", "app", "backoffice"] },
    "i18n": {
      "type": "object", "required": ["required", "defaultLocale", "urlStrategy"], "additionalProperties": false,
      "properties": {
        "required": { "const": true },
        "defaultLocale": { "enum": ["pt-BR", "en"] },
        "urlStrategy": {
          "type": "object", "required": ["public", "app", "backoffice"], "additionalProperties": false,
          "properties": {
            "public": { "enum": ["public-prefix", "cookie"] },
            "app": { "const": "cookie" },
            "backoffice": { "const": "cookie" }
          }
        }
      }
    },
    "profiles": { "type": "object", "required": ["public", "app", "backoffice"], "additionalProperties": { "$ref": "#/$defs/capabilities" } },
    "modules": {
      "type": "object", "additionalProperties": {
        "type": "object", "required": ["paths", "dependencies"], "additionalProperties": false,
        "properties": {
          "paths": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "devDependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": { "capabilities": {
    "type": "object", "required": ["auth", "bff", "query", "forms", "backoffice"], "additionalProperties": false,
    "properties": { "auth": { "type": "boolean" }, "bff": { "type": "boolean" }, "query": { "type": "boolean" }, "forms": { "type": "boolean" }, "backoffice": { "type": "boolean" } }
  } }
}
