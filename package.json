{
  "name": "ginga-nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "dev:login": "node scripts/dev-login.mjs",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "api:sync": "node scripts/api-sync.mjs",
    "api:types": "node scripts/api-sync.mjs --types-only",
    "api:check": "npm run api:types && git diff --exit-code -- src/lib/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:modes": "node scripts/test-modes.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "security:check": "node scripts/security-check.mjs && npm audit --omit=dev --audit-level=high",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ginga/ui": "file:vendor/ginga-software-ui-0.1.7.tgz",
    "@hookform/resolvers": "5.9.1",
    "@sentry/nextjs": "11.4.0",
    "@tanstack/react-query": "5.102.8",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "next": "16.3.8",
    "next-intl": "4.14.5",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --max-warnings 0"
  }
}
