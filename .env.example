# CORE — public works without Identity or a Product API.
APP_KIND=public
APP_URL=http://localhost:3000
APP_NAME=Ginga Application

# AUTH — required only for app/backoffice. Existing Identity client names.
# OIDC_ISSUER=http://localhost:4000/api/auth
# OIDC_CLIENT_ID=
# OIDC_CLIENT_TYPE=confidential
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=http://localhost:5000
# OIDC_ALLOW_HTTP=true
# OIDC_MAX_AGE=3600

# Single Node process only; set true after choosing that production topology.
# SESSION_STORE=memory
# SESSION_SINGLE_PROCESS=true
# SESSION_TTL_SECONDS=28800

# BFF — optional until a product operation is integrated.
# PRODUCT_API_URL=http://localhost:5000
