# CORE — public works without Identity or a Product API.
# APP_KIND=public
APP_URL=http://localhost:3000
APP_NAME=Ginga Application

# FEATURE FLAGS — registry in src/config/flags.ts; unknown names fail at boot.
# FEATURE_FLAGS=rolesEditor=true

# I18N — mandatory Core. Supported: pt-BR, en.
I18N_DEFAULT_LOCALE=pt-BR
# public-prefix: public URLs have locale; auth profiles use cookie.
# cookie: no URL prefix, including public.
I18N_URL_STRATEGY=public-prefix

# AUTH — required only for app/backoffice. Existing Identity client names.
# AUTH_PROVIDER=fake: development-only sign-in without the Identity (OIDC_* ignored, refused in production).
# Same users/tokens as the API fake provider; see docs/authentication.md.
# AUTH_PROVIDER=fake
OIDC_ISSUER=http://localhost:4000/api/auth
OIDC_CLIENT_ID=
OIDC_CLIENT_TYPE=confidential
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=http://localhost:5000
OIDC_ALLOW_HTTP=true
OIDC_MAX_AGE=3600

# Keys sealing the session cookie (JWE A256GCM): comma-separated base64url 32-byte values, first one seals.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Different value per environment and per application; rotate by prepending a new key.
SESSION_SECRETS=
# SESSION_TTL_SECONDS=28800

# BFF — Product API. API_MODE=mock (default outside production) serves in-process
# fixtures with the same contract; live calls PRODUCT_API_URL. Mock is refused in production.
# API_MODE=mock
# API_MOCK_PERMISSIONS=*            # mock only: e.g. member:read,role:read to test restricted UIs
# PRODUCT_API_URL=http://localhost:5000
# ERROR TRACKING — server-only Sentry (src/server/error-tracking.ts); unset = disabled.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=homolog
